{
  "$schema": "https://raw.githubusercontent.com/ozooma10/osf-settings/dev/sdk/osf-settings.schema.json",
  "title": "Placement example",
  "description": "Three HUD widgets placed with the placement editor. Each placement saves ordinary int and float settings that the mod reads.",
  "groups": {
    "Compass": [
      {
        "type": "placement",
        "id": "compass",
        "label": "Compass placement",
        "hint": "Positioned by its top centre. Resize it from a corner to change its scale.",
        "size": { "width": 640, "height": 72 },
        "origin": { "x": 0.5, "y": 0 },
        "bind": { "x": "compassX", "top": "compassTop", "scale": "compassScale" }
      },
      { "key": "compassX", "type": "int", "label": "Compass centre", "default": 960, "min": 0, "max": 1920 },
      { "key": "compassTop", "type": "int", "label": "Compass top margin", "default": 32, "min": 0, "max": 1080 },
      { "key": "compassScale", "type": "float", "label": "Compass scale", "default": 1.0, "min": 0.5, "max": 2.0, "step": 0.05 }
    ],
    "Quest tracker": [
      {
        "type": "placement",
        "id": "tracker",
        "label": "Quest tracker placement",
        "hint": "Anchored to the right edge. Resize it from any edge or corner.",
        "bind": { "right": "trackerRight", "top": "trackerTop", "width": "trackerWidth", "height": "trackerHeight" }
      },
      { "key": "trackerRight", "type": "int", "label": "Tracker right margin", "default": 64, "min": 0, "max": 1920 },
      { "key": "trackerTop", "type": "int", "label": "Tracker top margin", "default": 220, "min": 0, "max": 1080 },
      { "key": "trackerWidth", "type": "int", "label": "Tracker width", "default": 420, "min": 200, "max": 900 },
      { "key": "trackerHeight", "type": "int", "label": "Tracker height", "default": 300, "min": 120, "max": 800 }
    ],
    "Health bar": [
      {
        "type": "placement",
        "id": "health",
        "label": "Health bar placement",
        "hint": "Anchored to the bottom-left corner, with a size that only scales.",
        "size": { "width": 360, "height": 40 },
        "bind": { "left": "healthLeft", "bottom": "healthBottom", "scale": "healthScale" }
      },
      { "key": "healthLeft", "type": "int", "label": "Health bar left margin", "default": 64, "min": 0, "max": 1920 },
      { "key": "healthBottom", "type": "int", "label": "Health bar bottom margin", "default": 72, "min": 0, "max": 1080 },
      { "key": "healthScale", "type": "float", "label": "Health bar scale", "default": 1.0, "min": 0.5, "max": 3.0, "step": 0.05 }
    ]
  }
}
