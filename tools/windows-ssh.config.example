# Example of the selected reverse-SSH relay. No VPN or Mac listener is needed.
# __BRIDGE_STATE__ is the private configuration directory outside the checkout.
# The reported relay IP is still awaiting external reachability verification.
Host osf-relay
    HostName 34.83.178.53
    Port 22
    User osf-mac-jump
    IdentityFile ~/.ssh/osf_mac_jump_ed25519
    IdentitiesOnly yes
    HostKeyAlias osf-relay-server
    UserKnownHostsFile "__BRIDGE_STATE__/known_hosts"
    StrictHostKeyChecking yes
    BatchMode yes
    ForwardAgent no
    ConnectTimeout 15
    ServerAliveInterval 30
    ServerAliveCountMax 3

Host osf-windows
    HostName 127.0.0.1
    Port 22022
    User skunko
    ProxyJump osf-relay
    IdentityFile ~/.ssh/osf_windows_login_ed25519
    IdentitiesOnly yes
    HostKeyAlias osf-windows-via-osf-relay
    UserKnownHostsFile "__BRIDGE_STATE__/known_hosts"
    StrictHostKeyChecking yes
    BatchMode yes
    ForwardAgent no
    ConnectTimeout 15
    ServerAliveInterval 30
    ServerAliveCountMax 3

Host *
