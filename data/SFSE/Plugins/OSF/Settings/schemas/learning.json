{
  "schemaVersion": 1,
  "title": "Test Mod",
  "description": "Sample settings and a native hotkey for testing the settings menu.",
  "hotkeys": {
    "testHotkey": {
      "label": "Test hotkey"
    }
  },
  "groups": {
    "General": [
      {
        "key": "notifications",
        "type": "bool",
        "label": "Enable notifications",
        "hint": "A test setting; no gameplay behavior is connected.",
        "default": true
      },
      {
        "key": "notificationLimit",
        "type": "int",
        "label": "Notification limit",
        "hint": "Choose a limit from 1 to 10. This test setting has no gameplay behavior.",
        "default": 3,
        "min": 1,
        "max": 10
      },
      {
        "key": "notificationVolume",
        "type": "float",
        "label": "Notification volume",
        "hint": "Choose a volume from 0.00 to 1.00 in steps of 0.05. This test setting has no gameplay behavior.",
        "default": 0.75,
        "min": 0.0,
        "max": 1.0,
        "step": 0.05
      },
      {
        "key": "notificationMode",
        "type": "enum",
        "label": "Notification mode",
        "hint": "Choose how much detail notifications show. This test setting has no gameplay behavior.",
        "default": "normal",
        "options": {
          "quiet": "Quiet",
          "normal": "Normal",
          "verbose": "Verbose"
        }
      },
      {
        "key": "notificationKey",
        "type": "key",
        "label": "Notification key",
        "hint": "Choose a keyboard key or clear the binding. This test setting has no gameplay behavior.",
        "default": "F4",
        "allowUnbound": true
      }
    ],
    "HUD layout": [
      {
        "type": "placement",
        "id": "testPanel",
        "label": "Test panel placement",
        "hint": "Drag the panel, or resize it from its edges and corners. This test placement has no gameplay behavior.",
        "bind": {
          "right": "panelRight",
          "top": "panelTop",
          "width": "panelWidth",
          "height": "panelHeight"
        }
      },
      {
        "key": "panelRight",
        "type": "int",
        "label": "Panel right margin",
        "default": 64,
        "min": 0,
        "max": 1920
      },
      {
        "key": "panelTop",
        "type": "int",
        "label": "Panel top margin",
        "default": 180,
        "min": 0,
        "max": 1080
      },
      {
        "key": "panelWidth",
        "type": "int",
        "label": "Panel width",
        "default": 420,
        "min": 120,
        "max": 1920
      },
      {
        "key": "panelHeight",
        "type": "int",
        "label": "Panel height",
        "default": 260,
        "min": 80,
        "max": 1080
      },
      {
        "type": "placement",
        "id": "testCompass",
        "label": "Test compass placement",
        "hint": "Drag the compass, or resize it from a corner to change its scale. This test placement has no gameplay behavior.",
        "size": {
          "width": 640,
          "height": 72
        },
        "origin": {
          "x": 0.5,
          "y": 0
        },
        "bind": {
          "x": "compassX",
          "top": "compassTop",
          "scale": "compassScale"
        }
      },
      {
        "key": "compassX",
        "type": "int",
        "label": "Compass center",
        "default": 960,
        "min": 0,
        "max": 1920
      },
      {
        "key": "compassTop",
        "type": "float",
        "label": "Compass top margin",
        "default": 32.0,
        "min": 0.0,
        "max": 1080.0,
        "step": 1.0
      },
      {
        "key": "compassScale",
        "type": "float",
        "label": "Compass scale",
        "default": 1.0,
        "min": 0.5,
        "max": 2.0,
        "step": 0.05
      }
    ]
  }
}
